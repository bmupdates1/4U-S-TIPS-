generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum UserRole {
  SUPER_ADMIN
  TIPSTER
}

enum TipCategory {
  FREE
  PREMIUM
}

enum TipResult {
  PENDING
  WON
  LOST
  VOID
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(TIPSTER)
  isActive     Boolean  @default(true)
  tips         Tip[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tip {
  id           String      @id @default(uuid())
  tipsterId    String
  tipster      User        @relation(fields: [tipsterId], references: [id])
  matchName    String
  prediction   String
  odds         Decimal?    @db.Decimal(8, 2)
  category     TipCategory @default(FREE)
  result       TipResult   @default(PENDING)
  kickoffAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tipsterId, createdAt])
  @@index([result])
}
